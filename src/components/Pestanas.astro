---
const rawHtml = await Astro.slots.render('default');
const matches = [...rawHtml.matchAll(/data-titulo="([^"]+)"/g)];
const titulos = matches.map((m) => m[1]);
const idBase = 'pestanas-' + Math.random().toString(36).slice(2, 9);

let panelIndex = 0;
const processedHtml = rawHtml.replace(
  /<div class="pestana-panel[^"]*" data-titulo="[^"]*"/g,
  (match) => {
    const currentIdx = panelIndex++;
    const isFirst = currentIdx === 0;
    return `${match} id="${idBase}-panel-${currentIdx}" role="tabpanel" aria-labelledby="${idBase}-tab-${currentIdx}" tabindex="0" ${isFirst ? '' : 'hidden'}`;
  }
);
---

<div class="pestanas-grupo my-8 border border-linea bg-superficie p-5">
  <div
    role="tablist"
    aria-label="Pestañas de contenido"
    class="flex gap-2 border-b border-linea overflow-x-auto"
  >
    {titulos.map((titulo, i) => (
      <button
        type="button"
        role="tab"
        id={`${idBase}-tab-${i}`}
        aria-controls={`${idBase}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class={`pestana-boton -mb-px px-4 py-2.5 text-sm font-semibold transition-colors border-b-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo ${
          i === 0
            ? 'border-indigo text-indigo font-bold'
            : 'border-transparent text-tinta-suave hover:text-tinta'
        }`}
      >
        {titulo}
      </button>
    ))}
  </div>

  <div class="pestanas-paneles mt-4 text-sm text-tinta">
    <Fragment set:html={processedHtml} />
  </div>
</div>

<script is:inline>
  (function() {
    function inicializarPestanas() {
      const grupos = document.querySelectorAll('.pestanas-grupo');
      grupos.forEach((grupo) => {
        if (grupo.dataset.iniciado === 'true') return;
        grupo.dataset.iniciado = 'true';

        const tabs = Array.from(grupo.querySelectorAll('[role="tab"]'));
        const panels = Array.from(grupo.querySelectorAll('[role="tabpanel"]'));

        function activarTab(nuevoIndex) {
          tabs.forEach((tab, i) => {
            const activo = i === nuevoIndex;
            tab.setAttribute('aria-selected', activo ? 'true' : 'false');
            tab.setAttribute('tabindex', activo ? '0' : '-1');
            if (activo) {
              tab.classList.add('border-indigo', 'text-indigo', 'font-bold');
              tab.classList.remove('border-transparent', 'text-tinta-suave');
              tab.focus();
            } else {
              tab.classList.remove('border-indigo', 'text-indigo', 'font-bold');
              tab.classList.add('border-transparent', 'text-tinta-suave');
            }
          });

          panels.forEach((panel, i) => {
            if (i === nuevoIndex) {
              panel.removeAttribute('hidden');
            } else {
              panel.setAttribute('hidden', '');
            }
          });
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activarTab(index));

          tab.addEventListener('keydown', (e) => {
            let nextIndex = null;
            if (e.key === 'ArrowRight') {
              nextIndex = (index + 1) % tabs.length;
            } else if (e.key === 'ArrowLeft') {
              nextIndex = (index - 1 + tabs.length) % tabs.length;
            } else if (e.key === 'Home') {
              nextIndex = 0;
            } else if (e.key === 'End') {
              nextIndex = tabs.length - 1;
            }

            if (nextIndex !== null) {
              e.preventDefault();
              activarTab(nextIndex);
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', inicializarPestanas);
    } else {
      inicializarPestanas();
    }
  })();
</script>
