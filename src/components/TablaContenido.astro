---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
const encabezados = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{encabezados.length > 0 && (
  <nav aria-label="Tabla de contenidos" class="toc-componente">
    {/* Versión móvil colapsable */}
    <details class="lg:hidden my-6 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm dark:border-slate-800 dark:bg-slate-900/60">
      <summary class="font-bold text-slate-800 dark:text-slate-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded">
        En este artículo ({encabezados.length})
      </summary>
      <ul class="mt-3 space-y-2 border-t border-slate-200 pt-3 text-xs dark:border-slate-800">
        {encabezados.map((h) => (
          <li class={h.depth === 3 ? 'ml-4' : 'ml-0 font-medium'}>
            <a
              href={`#${h.slug}`}
              class="text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 transition-colors block py-0.5"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>

    {/* Versión escritorio sticky */}
    <div class="hidden lg:block sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto rounded-xl border border-slate-200 bg-white p-5 text-sm dark:border-slate-800 dark:bg-slate-900/80 shadow-xs">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">
        En este artículo
      </h2>
      <ul class="space-y-2.5 text-xs">
        {encabezados.map((h) => (
          <li class={h.depth === 3 ? 'ml-3' : 'ml-0'}>
            <a
              href={`#${h.slug}`}
              data-slug={h.slug}
              class="toc-enlace block text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 transition-colors py-0.5 border-l-2 border-transparent pl-2.5"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <script is:inline>
    (function() {
      function iniciarObservadorTOC() {
        const enlaces = document.querySelectorAll('.toc-enlace');
        if (!enlaces.length) return;

        const encabezadosObservados = [];
        enlaces.forEach((enlace) => {
          const slug = enlace.dataset.slug;
          if (slug) {
            const el = document.getElementById(slug);
            if (el) encabezadosObservados.push(el);
          }
        });

        if (!encabezadosObservados.length) return;

        const observer = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                const id = entrada.target.id;
                enlaces.forEach((enlace) => {
                  const coincide = enlace.dataset.slug === id;
                  if (coincide) {
                    enlace.classList.add('text-indigo-600', 'font-bold', 'border-indigo-600', 'dark:text-indigo-400', 'dark:border-indigo-400');
                    enlace.classList.remove('border-transparent');
                  } else {
                    enlace.classList.remove('text-indigo-600', 'font-bold', 'border-indigo-600', 'dark:text-indigo-400', 'dark:border-indigo-400');
                    enlace.classList.add('border-transparent');
                  }
                });
              }
            });
          },
          { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
        );

        encabezadosObservados.forEach((h) => observer.observe(h));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciarObservadorTOC);
      } else {
        iniciarObservadorTOC();
      }
    })();
  </script>
)}
