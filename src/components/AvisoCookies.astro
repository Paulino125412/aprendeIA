---
// AvisoCookies.astro - Aviso de consentimiento conforme a privacidad y Google AdSense
---

<div
  id="banner-cookies"
  role="dialog"
  aria-labelledby="titulo-cookies"
  aria-describedby="desc-cookies"
  hidden
  class="fixed bottom-0 inset-x-0 z-50 p-4 sm:p-6 transition-transform duration-300 pointer-events-none"
>
  <div class="max-w-4xl mx-auto border border-linea bg-superficie p-5 sm:p-6 pointer-events-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="space-y-1.5 max-w-2xl text-xs sm:text-sm text-tinta-suave leading-relaxed">
      <h2 id="titulo-cookies" class="font-bold text-tinta text-sm">
        Aviso de privacidad y cookies
      </h2>
      <p id="desc-cookies">
        Utilizamos cookies técnicas para recordar tus preferencias y, con tu consentimiento, cookies de terceros (Google AdSense) para mostrar anuncios. Puedes aceptar o rechazar la personalización sin afectar tu lectura. Más información en nuestra <a href="/privacidad" class="text-indigo underline font-medium hover:opacity-80">Política de Privacidad</a>.
      </p>
    </div>

    <!-- Botones de igual peso visual con radio 6px -->
    <div class="flex items-center gap-2.5 w-full md:w-auto shrink-0">
      <button
        type="button"
        id="btn-cookies-rechazar"
        class="flex-1 md:flex-none px-4 py-2 rounded-[6px] text-xs font-semibold border border-linea bg-papel hover:bg-superficie text-tinta transition-colors cursor-pointer text-center focus:outline-none focus:ring-2 focus:ring-indigo"
      >
        Rechazar
      </button>
      <button
        type="button"
        id="btn-cookies-aceptar"
        class="flex-1 md:flex-none px-4 py-2 rounded-[6px] text-xs font-semibold border border-linea bg-papel hover:bg-superficie text-tinta transition-colors cursor-pointer text-center focus:outline-none focus:ring-2 focus:ring-indigo"
      >
        Aceptar
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const banner = document.getElementById('banner-cookies');
    const btnAceptar = document.getElementById('btn-cookies-aceptar');
    const btnRechazar = document.getElementById('btn-cookies-rechazar');
    const btnReabrir = document.getElementById('btn-preferencias-cookies');
    let reabiertoDesdeFooter = false;

    function obtenerConsentimiento() {
      try {
        return localStorage.getItem('consentimiento-cookies');
      } catch (_) {
        return null;
      }
    }

    function guardarConsentimiento(valor) {
      try {
        localStorage.setItem('consentimiento-cookies', valor);
      } catch (_) {}
      cerrarBanner();
      if (typeof window.__iniciarAdSense === 'function') {
        window.__iniciarAdSense(valor);
      }
    }

    function abrirBanner(moverFoco) {
      if (!banner) return;
      banner.removeAttribute('hidden');
      if (moverFoco) {
        reabiertoDesdeFooter = true;
        btnAceptar?.focus();
      }
    }

    function cerrarBanner() {
      if (!banner) return;
      banner.setAttribute('hidden', '');
      if (reabiertoDesdeFooter) {
        reabiertoDesdeFooter = false;
        btnReabrir?.focus();
      }
    }

    // Comprobación inicial: si no hay decisión, mostrar banner
    const decision = obtenerConsentimiento();
    if (!decision) {
      abrirBanner(false);
    }

    btnAceptar?.addEventListener('click', function() {
      guardarConsentimiento('aceptado');
    });

    btnRechazar?.addEventListener('click', function() {
      guardarConsentimiento('rechazado');
    });

    // Botón del footer para reabrir
    btnReabrir?.addEventListener('click', function(e) {
      e.preventDefault();
      abrirBanner(true);
    });

    // Cerrar con Escape sin guardar
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && banner && !banner.hasAttribute('hidden')) {
        cerrarBanner();
      }
    });
  })();
</script>
