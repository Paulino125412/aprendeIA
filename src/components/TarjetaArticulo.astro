---
import type { CollectionEntry } from 'astro:content';
import { getCategoria } from '../data/categorias';

interface Props {
  articulo: CollectionEntry<'articulos'>;
}

const { articulo } = Astro.props;
const { titulo, descripcion, categoria, fecha } = articulo.data;
const infoCategoria = getCategoria(categoria);

const fechaFormateada = new Intl.DateTimeFormat('es-PE', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(fecha);

const palabras = articulo.body ? articulo.body.split(/\s+/).filter(Boolean).length : 0;
const tiempoLecturaMinutos = Math.max(1, Math.ceil(palabras / 200));
---

<article class={`group flex flex-col justify-between border border-linea bg-superficie p-6 border-l-[3px] ${infoCategoria?.clases.bordeLateral || 'border-l-indigo'}`}>
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      {infoCategoria && (
        <a
          href={`/categoria/${infoCategoria.slug}`}
          class={`font-display text-xs font-bold ${infoCategoria.clases.texto} hover:underline`}
        >
          {infoCategoria.nombre}
        </a>
      )}

      <!-- Metadatos separados por espacio (sin puntos medios) -->
      <div class="flex items-center gap-3 text-xs text-tinta-suave">
        <time datetime={fecha.toISOString()}>{fechaFormateada}</time>
        <span>{tiempoLecturaMinutos} min de lectura</span>
      </div>
    </div>

    <h2 class="text-xl font-bold tracking-tight text-tinta group-hover:text-indigo transition-colors">
      <a href={`/articulos/${articulo.id}`} class="focus:outline-none focus:underline">
        {titulo}
      </a>
    </h2>

    <p class="text-sm text-tinta-suave leading-relaxed line-clamp-3">
      {descripcion}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-linea flex items-center justify-between">
    <a
      href={`/articulos/${articulo.id}`}
      class="text-xs font-semibold text-indigo hover:underline"
      aria-label={`Leer artículo: ${titulo}`}
    >
      Leer guía completa
    </a>
  </div>
</article>
