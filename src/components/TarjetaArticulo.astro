---
import type { CollectionEntry } from 'astro:content';
import { getCategoria } from '../data/categorias';

interface Props {
  articulo: CollectionEntry<'articulos'>;
}

const { articulo } = Astro.props;
const { titulo, descripcion, categoria, fecha } = articulo.data;
const infoCategoria = getCategoria(categoria);

const fechaFormateada = new Intl.DateTimeFormat('es-PE', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(fecha);

const palabras = articulo.body ? articulo.body.split(/\s+/).filter(Boolean).length : 0;
const tiempoLecturaMinutos = Math.max(1, Math.ceil(palabras / 200));
---

<article class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700">
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      {infoCategoria && (
        <a
          href={`/categoria/${infoCategoria.slug}`}
          class={`inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full border transition-opacity hover:opacity-80 ${infoCategoria.clases.badge}`}
        >
          <span>{infoCategoria.emoji}</span>
          <span>{infoCategoria.nombre}</span>
        </a>
      )}

      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <time datetime={fecha.toISOString()}>{fechaFormateada}</time>
        <span>•</span>
        <span>{tiempoLecturaMinutos} min de lectura</span>
      </div>
    </div>

    <h2 class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400 transition-colors">
      <a href={`/articulos/${articulo.id}`} class="focus:outline-none focus:underline">
        {titulo}
      </a>
    </h2>

    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3">
      {descripcion}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
    <a
      href={`/articulos/${articulo.id}`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors"
      aria-label={`Leer artículo: ${titulo}`}
    >
      <span>Leer guía completa</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
