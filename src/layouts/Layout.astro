---
import '../styles/global.css';
import { CATEGORIAS } from '../data/categorias';
import { SITIO } from '../config';
import Cabecera from '../components/Cabecera.astro';
import AvisoCookies from '../components/AvisoCookies.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  imagen?: string;
  tipoOg?: 'website' | 'article';
}

const {
  title,
  description = SITIO.eslogan,
  noindex = false,
  imagen,
  tipoOg = 'website',
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || '';
const anioActual = new Date().getFullYear();
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={tipoOg} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={SITIO.nombre} />
    {imagen && <meta property="og:image" content={imagen} />}
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <slot name="head" />

    <!-- Script en línea para prevenir parpadeo de modo oscuro -->
    <script is:inline>
      (function() {
        try {
          const tema = localStorage.getItem('tema');
          const prefiereOscuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (tema === 'oscuro' || (!tema && prefiereOscuro)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>
  <body class="min-h-full flex flex-col justify-between bg-papel text-tinta font-display antialiased selection:bg-indigo selection:text-sobre-acento">
    <!-- Enlace accesible de salto al contenido (sin sombra) -->
    <a
      href="#contenido-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-indigo text-sobre-acento font-semibold rounded-[6px]"
    >
      Saltar al contenido
    </a>

    <!-- Cabecera editorial -->
    <Cabecera />

    <main id="contenido-principal" class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
      <slot />
    </main>

    <footer class="border-t border-linea bg-superficie mt-16 py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-8">
          <!-- Columna Marca -->
          <div class="sm:col-span-2 lg:col-span-2 space-y-3">
            <a href="/" class="font-display font-bold text-lg text-tinta hover:text-indigo transition-colors">
              {SITIO.nombre}
            </a>
            <p class="text-xs text-tinta-suave leading-relaxed max-w-sm">
              {SITIO.eslogan} Plataforma formativa e interactiva desarrollada desde {SITIO.pais}.
            </p>
          </div>

          <!-- Columna Sitio -->
          <div class="space-y-3">
            <h3 class="text-xs font-bold text-tinta">
              Sitio
            </h3>
            <ul class="space-y-2 text-xs">
              <li>
                <a href="/" class="text-tinta-suave hover:text-indigo transition-colors">
                  Inicio
                </a>
              </li>
              <li>
                <a href="/articulos" class="text-tinta-suave hover:text-indigo transition-colors">
                  Artículos y guías
                </a>
              </li>
              <li>
                <a href="/sobre-nosotros" class="text-tinta-suave hover:text-indigo transition-colors">
                  Sobre nosotros
                </a>
              </li>
              <li>
                <a href="/contacto" class="text-tinta-suave hover:text-indigo transition-colors">
                  Contacto
                </a>
              </li>
            </ul>
          </div>

          <!-- Columna Legal -->
          <div class="space-y-3">
            <h3 class="text-xs font-bold text-tinta">
              Legal
            </h3>
            <ul class="space-y-2 text-xs">
              <li>
                <a href="/privacidad" class="text-tinta-suave hover:text-indigo transition-colors">
                  Política de Privacidad
                </a>
              </li>
              <li>
                <a href="/terminos" class="text-tinta-suave hover:text-indigo transition-colors">
                  Términos de Uso
                </a>
              </li>
              <li>
                <button
                  type="button"
                  id="btn-preferencias-cookies"
                  class="text-tinta-suave hover:text-indigo transition-colors text-left cursor-pointer focus:outline-none focus:underline"
                >
                  Preferencias de cookies
                </button>
              </li>
            </ul>
          </div>

          <!-- Columna Categorías (9 categorías completas sin emojis) -->
          <div class="sm:col-span-2 lg:col-span-2 space-y-3">
            <h3 class="text-xs font-bold text-tinta">
              Categorías
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 text-xs">
              {CATEGORIAS.map((cat) => (
                <a
                  href={`/categoria/${cat.slug}`}
                  class="text-tinta-suave hover:text-indigo transition-colors flex items-center gap-1.5 truncate min-w-0"
                >
                  <span class="truncate">{cat.nombre}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="mt-12 pt-6 border-t border-linea flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-tinta-suave">
          <p>© {anioActual} {SITIO.nombre}. {SITIO.autor}. Todos los derechos reservados.</p>
          <p>Educación abierta en español neutro.</p>
        </div>
      </div>
    </footer>

    <!-- Inyección condicional de AdSense por consentimiento -->
    {adsenseClient && (
      <script is:inline define:vars={{ adsenseClient }}>
        (function() {
          if (!adsenseClient) return;

          window.__iniciarAdSense = function(decision) {
            if (window.__adsenseInyectado) return;
            if (decision !== 'aceptado' && decision !== 'rechazado') return;

            if (decision === 'rechazado') {
              (window.adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds = 1;
            }

            const script = document.createElement('script');
            script.async = true;
            script.crossOrigin = 'anonymous';
            script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + encodeURIComponent(adsenseClient);
            document.head.appendChild(script);
            window.__adsenseInyectado = true;
          };

          // Si ya hay decisión previa en localStorage, inyectar inmediatamente
          try {
            const decisionGuardada = localStorage.getItem('consentimiento-cookies');
            if (decisionGuardada) {
              window.__iniciarAdSense(decisionGuardada);
            }
          } catch (_) {}
        })();
      </script>
    )}

    <!-- Componente de aviso de cookies -->
    <AvisoCookies />

    <!-- Elemento del cursor personalizado para la cabecera (Desktop) -->
    <div id="cursor-cabecera-punto" aria-hidden="true"></div>

    <!-- Script para control de tema claro/oscuro -->
    <script is:inline>
      (function() {
        const botonTema = document.getElementById('btn-tema');
        if (botonTema) {
          function actualizarAriaLabel(esOscuro) {
            botonTema.setAttribute(
              'aria-label',
              esOscuro ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'
            );
          }

          actualizarAriaLabel(document.documentElement.classList.contains('dark'));

          botonTema.addEventListener('click', function() {
            const esOscuro = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('tema', esOscuro ? 'oscuro' : 'claro');
            } catch (_) {}
            actualizarAriaLabel(esOscuro);
          });
        }
      })();
    </script>

    <!-- Script de interactividad: Animaciones de entrada, contadores y cursor -->
    <script is:inline>
      (function() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1. ANIMACIÓN: Fade-in hacia arriba (.animar-entrada) con IntersectionObserver
        const elementosParaAnimar = document.querySelectorAll('.animar-entrada-init');
        if (elementosParaAnimar.length > 0) {
          if (reduceMotion || !('IntersectionObserver' in window)) {
            elementosParaAnimar.forEach(function(el) {
              el.classList.remove('animar-entrada-init');
            });
          } else {
            const observerEntrada = new IntersectionObserver(function(entries, observer) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.remove('animar-entrada-init');
                  entry.target.classList.add('animar-entrada');
                  observer.unobserve(entry.target);
                }
              });
            }, {
              threshold: 0.15,
              rootMargin: '0px 0px -40px 0px'
            });

            elementosParaAnimar.forEach(function(el) {
              observerEntrada.observe(el);
            });
          }
        }

        // 2. ANIMACIÓN: Contador numérico animado (16+, 30+, 100%)
        const elementosContador = document.querySelectorAll('[data-contador-valor]');
        if (elementosContador.length > 0) {
          function animarContador(elemento) {
            const valorFinal = parseInt(elemento.getAttribute('data-contador-valor'), 10);
            const sufijo = elemento.getAttribute('data-contador-sufijo') || '';
            if (isNaN(valorFinal)) return;

            if (reduceMotion) {
              elemento.textContent = valorFinal + sufijo;
              return;
            }

            const duracion = 1200; // 1.2 segundos
            const tiempoInicio = performance.now();

            function actualizarNumero(tiempoActual) {
              const transcurrido = tiempoActual - tiempoInicio;
              const progreso = Math.min(transcurrido / duracion, 1);
              // Easing easeOutExpo
              const eased = progreso === 1 ? 1 : 1 - Math.pow(2, -10 * progreso);
              const valorActual = Math.floor(eased * valorFinal);

              elemento.textContent = valorActual + sufijo;

              if (progreso < 1) {
                requestAnimationFrame(actualizarNumero);
              } else {
                elemento.textContent = valorFinal + sufijo;
              }
            }

            requestAnimationFrame(actualizarNumero);
          }

          if (reduceMotion || !('IntersectionObserver' in window)) {
            elementosContador.forEach(function(el) {
              const valor = el.getAttribute('data-contador-valor');
              const sufijo = el.getAttribute('data-contador-sufijo') || '';
              el.textContent = valor + sufijo;
            });
          } else {
            const observerContadores = new IntersectionObserver(function(entries, observer) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                  animarContador(entry.target);
                  observer.unobserve(entry.target);
                }
              });
            }, { threshold: 0.2 });

            elementosContador.forEach(function(el) {
              observerContadores.observe(el);
            });
          }
        }

        // 5. EFECTO: Cursor personalizado para la cabecera (Desktop y sin reduced-motion)
        const cabecera = document.querySelector('header');
        const puntoCursor = document.getElementById('cursor-cabecera-punto');
        if (cabecera && puntoCursor && !reduceMotion) {
          let mouseX = 0;
          let mouseY = 0;
          let posX = 0;
          let posY = 0;
          let dentroDeCabecera = false;
          let rafId = null;

          function loopCursor() {
            if (!dentroDeCabecera) return;
            // Interpolación lineal suave (smooth lag)
            posX += (mouseX - posX) * 0.25;
            posY += (mouseY - posY) * 0.25;

            puntoCursor.style.left = posX + 'px';
            puntoCursor.style.top = posY + 'px';

            rafId = requestAnimationFrame(loopCursor);
          }

          function comprobarDesktop() {
            return window.innerWidth > 768;
          }

          cabecera.addEventListener('mouseenter', function(e) {
            if (!comprobarDesktop()) return;
            dentroDeCabecera = true;
            mouseX = e.clientX;
            mouseY = e.clientY;
            posX = e.clientX;
            posY = e.clientY;
            puntoCursor.style.left = posX + 'px';
            puntoCursor.style.top = posY + 'px';
            puntoCursor.classList.add('activo');
            if (!rafId) {
              rafId = requestAnimationFrame(loopCursor);
            }
          });

          cabecera.addEventListener('mousemove', function(e) {
            if (!comprobarDesktop()) return;
            mouseX = e.clientX;
            mouseY = e.clientY;
          });

          cabecera.addEventListener('mouseleave', function() {
            dentroDeCabecera = false;
            puntoCursor.classList.remove('activo');
            if (rafId) {
              cancelAnimationFrame(rafId);
              rafId = null;
            }
          });
        }
      })();
    </script>
  </body>
</html>
