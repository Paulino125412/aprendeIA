---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import { getCategoria } from '../data/categorias';
import { SITIO } from '../config';
import TablaContenido from '../components/TablaContenido.astro';
import Anuncio from '../components/Anuncio.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'articulos'>;
  headings: HeadingItem[];
}

const { entry, headings } = Astro.props;
const { titulo, descripcion, categoria, fecha, actualizado } = entry.data;

const infoCategoria = getCategoria(categoria);

const fechaFormateada = new Intl.DateTimeFormat('es-PE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(fecha);

const actualizadoFormateado = actualizado
  ? new Intl.DateTimeFormat('es-PE', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(actualizado)
  : null;

const palabras = entry.body ? entry.body.split(/\s+/).filter(Boolean).length : 0;
const tiempoLecturaMinutos = Math.max(1, Math.ceil(palabras / 200));

// Navegación anterior y siguiente dentro de la misma categoría según orden
const todos = await getCollection('articulos');
const deMismaCategoria = todos
  .filter((art) => art.data.categoria === categoria)
  .sort((a, b) => a.data.orden - b.data.orden || a.data.fecha.getTime() - b.data.fecha.getTime());

const indiceActual = deMismaCategoria.findIndex((art) => art.id === entry.id);
const anterior = indiceActual > 0 ? deMismaCategoria[indiceActual - 1] : null;
const siguiente = indiceActual >= 0 && indiceActual < deMismaCategoria.length - 1 ? deMismaCategoria[indiceActual + 1] : null;

// URLs y Schemas JSON-LD
const siteUrl = Astro.site ? Astro.site.origin : '';
const urlInicio = siteUrl ? new URL('/', Astro.site).href : '/';
const urlCategoria = siteUrl ? new URL(`/categoria/${categoria}`, Astro.site).href : `/categoria/${categoria}`;
const urlArticulo = siteUrl ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const jsonLdArticulo = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': titulo,
  'description': descripcion,
  'datePublished': fecha.toISOString(),
  'dateModified': (actualizado || fecha).toISOString(),
  'author': {
    '@type': 'Organization',
    'name': SITIO.autor,
  },
  'publisher': {
    '@type': 'Organization',
    'name': SITIO.nombre,
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': urlArticulo,
  },
};

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Inicio',
      'item': urlInicio,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': infoCategoria ? infoCategoria.nombre : categoria,
      'item': urlCategoria,
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': titulo,
      'item': urlArticulo,
    },
  ],
};
---

<Layout title={`${titulo} | AprendeIA`} description={descripcion} tipoOg="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticulo)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- a) Barra de progreso de lectura (3px fija arriba) -->
  <div
    id="barra-progreso-lectura"
    aria-hidden="true"
    class="fixed top-0 left-0 h-[3px] bg-indigo z-50 w-0 motion-reduce:transition-none transition-[width] duration-75 pointer-events-none"
  ></div>

  <div class="max-w-6xl mx-auto">
    <!-- Migas de pan accesibles -->
    <nav aria-label="Migas de pan" class="mb-6 flex items-center gap-2 text-xs font-medium text-tinta-suave flex-wrap">
      <a href="/" class="hover:text-indigo transition-colors">
        Inicio
      </a>
      <span>/</span>
      {infoCategoria && (
        <>
          <a href={`/categoria/${infoCategoria.slug}`} class={`hover:underline ${infoCategoria.clases.texto}`}>
            {infoCategoria.nombre}
          </a>
          <span>/</span>
        </>
      )}
      <span class="text-tinta font-semibold truncate max-w-xs sm:max-w-md">
        {titulo}
      </span>
    </nav>

    <!-- Cabecera del Artículo -->
    <header class="mb-8 space-y-4 border-b border-linea pb-8">
      {infoCategoria && (
        <a
          href={`/categoria/${infoCategoria.slug}`}
          class={`font-display text-xs font-bold ${infoCategoria.clases.texto} hover:underline block`}
        >
          {infoCategoria.nombre}
        </a>
      )}

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-tinta leading-tight">
        {titulo}
      </h1>

      <p class="text-lg text-tinta-suave leading-relaxed max-w-4xl">
        {descripcion}
      </p>

      <!-- Metadatos limpios separados por espacio -->
      <div class="flex items-center gap-4 text-xs text-tinta-suave flex-wrap pt-2">
        <time datetime={fecha.toISOString()}>Publicado el {fechaFormateada}</time>
        {actualizadoFormateado && (
          <span class="text-indigo font-medium">
            Actualizado el {actualizadoFormateado}
          </span>
        )}
        <span>{tiempoLecturaMinutos} min de lectura</span>
      </div>
    </header>

    <!-- Anuncio inicial debajo de la cabecera -->
    <Anuncio posicion="inicio" />

    <!-- Disposición de contenido: 2 columnas con TOC en escritorio -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start my-8">
      <!-- Cuerpo del artículo -->
      <div class="lg:col-span-8 min-w-0">
        <!-- TOC versión móvil -->
        <div class="lg:hidden">
          <TablaContenido headings={headings} />
        </div>

        <article id="cuerpo-articulo" class="prose prose-lg max-w-none leading-relaxed [&_h2]:scroll-mt-24 [&_h3]:scroll-mt-24 [&_h4]:scroll-mt-24">
          <slot />
        </article>

        <!-- Anuncio final después del contenido -->
        <Anuncio posicion="final" />

        <!-- Navegación Anterior / Siguiente dentro de la categoría -->
        {(anterior || siguiente) && (
          <nav aria-label="Navegación entre artículos" class="my-10 pt-6 border-t border-linea grid grid-cols-1 sm:grid-cols-2 gap-4">
            {anterior ? (
              <a
                href={`/articulos/${anterior.id}`}
                class="flex flex-col p-4 border border-linea bg-superficie hover:border-indigo transition-colors group"
              >
                <span class="text-xs font-semibold text-tinta-suave mb-1">
                  Artículo anterior
                </span>
                <span class="text-sm font-bold text-tinta group-hover:text-indigo line-clamp-2">
                  {anterior.data.titulo}
                </span>
              </a>
            ) : <div />}

            {siguiente ? (
              <a
                href={`/articulos/${siguiente.id}`}
                class="flex flex-col p-4 border border-linea bg-superficie hover:border-indigo transition-colors text-right group"
              >
                <span class="text-xs font-semibold text-tinta-suave mb-1">
                  Siguiente artículo
                </span>
                <span class="text-sm font-bold text-tinta group-hover:text-indigo line-clamp-2">
                  {siguiente.data.titulo}
                </span>
              </a>
            ) : <div />}
          </nav>
        )}

        <!-- Artículos relacionados -->
        <ArticulosRelacionados categoria={categoria} slugActual={entry.id} />
      </div>

      <!-- Barra lateral fija en escritorio para Tabla de Contenido -->
      <aside class="hidden lg:block lg:col-span-4 pl-4">
        <TablaContenido headings={headings} />
      </aside>
    </div>
  </div>

  <!-- b) Botón "Volver arriba": aparece tras 800px de scroll, sin sombra, offset inferior seguro de 5rem -->
  <button
    id="btn-volver-arriba"
    type="button"
    aria-label="Volver arriba"
    class="fixed right-4 sm:right-6 bottom-20 z-40 p-2.5 rounded-[6px] border border-linea bg-superficie text-tinta opacity-0 pointer-events-none transition-opacity duration-200 cursor-pointer hover:bg-papel focus:outline-none focus:ring-2 focus:ring-indigo"
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15" />
    </svg>
  </button>

  <!-- Script para barra de progreso y botón volver arriba -->
  <script is:inline>
    (function() {
      const barraProgreso = document.getElementById('barra-progreso-lectura');
      const articulo = document.getElementById('cuerpo-articulo');
      const btnVolverArriba = document.getElementById('btn-volver-arriba');

      let ticking = false;

      function onScroll() {
        const scrollActual = window.scrollY || window.pageYOffset;

        // 1. Botón volver arriba tras 800px
        if (btnVolverArriba) {
          if (scrollActual > 800) {
            btnVolverArriba.classList.remove('opacity-0', 'pointer-events-none');
            btnVolverArriba.classList.add('opacity-100');
          } else {
            btnVolverArriba.classList.remove('opacity-100');
            btnVolverArriba.classList.add('opacity-0', 'pointer-events-none');
          }
        }

        // 2. Progreso de lectura sobre el <article>
        if (barraProgreso && articulo) {
          const rect = articulo.getBoundingClientRect();
          const alturaVentana = window.innerHeight;
          const alturaArticulo = rect.height;

          // Progreso desde que entra hasta que se termina de leer
          const distanciaRecorrida = alturaVentana - rect.top;
          const distanciaTotal = alturaArticulo + alturaVentana;

          let porcentaje = (distanciaRecorrida / distanciaTotal) * 100;
          if (porcentaje < 0) porcentaje = 0;
          if (porcentaje > 100) porcentaje = 100;

          barraProgreso.style.width = porcentaje + '%';
        }

        ticking = false;
      }

      window.addEventListener(
        'scroll',
        function() {
          if (!ticking) {
            window.requestAnimationFrame(onScroll);
            ticking = true;
          }
        },
        { passive: true }
      );

      btnVolverArriba?.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Ejecución inicial
      onScroll();
    })();
  </script>
</Layout>
