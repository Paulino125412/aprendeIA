---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import { getCategoria } from '../data/categorias';
import TablaContenido from '../components/TablaContenido.astro';
import Anuncio from '../components/Anuncio.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'articulos'>;
  headings: HeadingItem[];
}

const { entry, headings } = Astro.props;
const { titulo, descripcion, categoria, fecha, actualizado } = entry.data;

const infoCategoria = getCategoria(categoria);

const fechaFormateada = new Intl.DateTimeFormat('es-PE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(fecha);

const actualizadoFormateado = actualizado
  ? new Intl.DateTimeFormat('es-PE', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(actualizado)
  : null;

const palabras = entry.body ? entry.body.split(/\s+/).filter(Boolean).length : 0;
const tiempoLecturaMinutos = Math.max(1, Math.ceil(palabras / 200));

// Navegación anterior y siguiente dentro de la misma categoría según orden
const todos = await getCollection('articulos');
const deMismaCategoria = todos
  .filter((art) => art.data.categoria === categoria)
  .sort((a, b) => a.data.orden - b.data.orden || a.data.fecha.getTime() - b.data.fecha.getTime());

const indiceActual = deMismaCategoria.findIndex((art) => art.id === entry.id);
const anterior = indiceActual > 0 ? deMismaCategoria[indiceActual - 1] : null;
const siguiente = indiceActual >= 0 && indiceActual < deMismaCategoria.length - 1 ? deMismaCategoria[indiceActual + 1] : null;
---

<Layout title={`${titulo} | AprendeIA`} description={descripcion}>
  <div class="max-w-6xl mx-auto">
    <!-- Migas de pan accesibles -->
    <nav aria-label="Migas de pan" class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400 flex-wrap">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
        Inicio
      </a>
      <span>/</span>
      {infoCategoria && (
        <>
          <a href={`/categoria/${infoCategoria.slug}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center gap-1">
            <span>{infoCategoria.emoji}</span>
            <span>{infoCategoria.nombre}</span>
          </a>
          <span>/</span>
        </>
      )}
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate max-w-xs sm:max-w-md">
        {titulo}
      </span>
    </nav>

    <!-- Cabecera del Artículo -->
    <header class="mb-8 space-y-4 border-b border-slate-200 pb-8 dark:border-slate-800">
      {infoCategoria && (
        <a
          href={`/categoria/${infoCategoria.slug}`}
          class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full border transition-opacity hover:opacity-80 ${infoCategoria.clases.badge}`}
        >
          <span>{infoCategoria.emoji}</span>
          <span>{infoCategoria.nombre}</span>
        </a>
      )}

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
        {titulo}
      </h1>

      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-4xl">
        {descripcion}
      </p>

      <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400 flex-wrap pt-2">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
          <time datetime={fecha.toISOString()}>Publicado el {fechaFormateada}</time>
        </div>

        {actualizadoFormateado && (
          <div class="flex items-center gap-1.5 text-indigo-600 dark:text-indigo-400 font-medium">
            <span>•</span>
            <span>Actualizado: {actualizadoFormateado}</span>
          </div>
        )}

        <div class="flex items-center gap-1.5">
          <span>•</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span>{tiempoLecturaMinutos} min de lectura</span>
        </div>
      </div>
    </header>

    <!-- Anuncio inicial debajo de la cabecera -->
    <Anuncio posicion="inicio" />

    <!-- Disposición de contenido: 2 columnas con TOC en escritorio -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start my-8">
      <!-- Cuerpo del artículo -->
      <div class="lg:col-span-8 min-w-0">
        <!-- TOC versión móvil (aparece al inicio en pantallas pequeñas) -->
        <div class="lg:hidden">
          <TablaContenido headings={headings} />
        </div>

        <article class="prose prose-lg dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 leading-relaxed [&_h2]:scroll-mt-24 [&_h3]:scroll-mt-24 [&_h4]:scroll-mt-24">
          <slot />
        </article>

        <!-- Anuncio final después del contenido -->
        <Anuncio posicion="final" />

        <!-- Navegación Anterior / Siguiente dentro de la categoría -->
        {(anterior || siguiente) && (
          <nav aria-label="Navegación entre artículos" class="my-10 pt-6 border-t border-slate-200 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {anterior ? (
              <a
                href={`/articulos/${anterior.id}`}
                class="flex flex-col p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-500 transition-colors group"
              >
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1 flex items-center gap-1">
                  ← Artículo anterior
                </span>
                <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 line-clamp-2">
                  {anterior.data.titulo}
                </span>
              </a>
            ) : <div />}

            {siguiente ? (
              <a
                href={`/articulos/${siguiente.id}`}
                class="flex flex-col p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-500 transition-colors text-right group"
              >
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1 flex items-center justify-end gap-1">
                  Siguiente artículo →
                </span>
                <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 line-clamp-2">
                  {siguiente.data.titulo}
                </span>
              </a>
            ) : <div />}
          </nav>
        )}

        <!-- Artículos relacionados -->
        <ArticulosRelacionados categoria={categoria} slugActual={entry.id} />
      </div>

      <!-- Barra lateral fija en escritorio para Tabla de Contenido -->
      <aside class="hidden lg:block lg:col-span-4 pl-4">
        <TablaContenido headings={headings} />
      </aside>
    </div>
  </div>
</Layout>
