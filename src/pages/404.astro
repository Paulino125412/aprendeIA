---
import Layout from '../layouts/Layout.astro';
import { CATEGORIAS } from '../data/categorias';
import { SITIO } from '../config';
---

<Layout
  title={`Página no encontrada (404) | ${SITIO.nombre}`}
  description="La página que buscas no existe o ha sido movida. Explora nuestras guías y categorías de Inteligencia Artificial."
  noindex={true}
>
  <div class="max-w-3xl mx-auto py-12 text-center space-y-8">
    <div class="space-y-4">
      <p class="text-xs font-bold text-rosa uppercase tracking-wider">
        Error 404
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-tinta">
        Página no encontrada
      </h1>
      <p class="text-base text-tinta-suave max-w-lg mx-auto">
        El enlace que seguiste no existe, fue renombrado o ha cambiado de ubicación. Te invitamos a retomar la navegación desde aquí:
      </p>
    </div>

    <!-- Acciones principales -->
    <div class="flex items-center justify-center gap-4 flex-wrap">
      <a
        href="/"
        class="px-5 py-2.5 rounded-[6px] text-sm font-bold bg-indigo text-white hover:opacity-90 transition-opacity"
      >
        Ir a la página de inicio
      </a>
      <a
        href="/articulos"
        class="px-5 py-2.5 rounded-[6px] text-sm font-semibold border border-linea bg-superficie text-tinta hover:bg-papel transition-colors"
      >
        Ver todos los artículos
      </a>
    </div>

    <!-- Accesos rápidos por categorías -->
    <div class="pt-8 border-t border-linea text-left space-y-4">
      <h2 class="text-xs font-bold uppercase tracking-wider text-tinta-suave text-center">
        O explora directamente por categoría
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {CATEGORIAS.map((cat) => (
          <a
            href={`/categoria/${cat.slug}`}
            class={`p-3 border border-linea bg-superficie border-l-[3px] ${cat.clases.bordeLateral} hover:bg-papel transition-colors block`}
          >
            <span class={`text-xs font-bold ${cat.clases.texto} truncate block`}>
              {cat.nombre}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
