---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { CATEGORIAS, type Categoria } from '../../data/categorias';

export function getStaticPaths() {
  return CATEGORIAS.map((cat) => ({
    params: { slug: cat.slug },
    props: { categoria: cat },
  }));
}

interface Props {
  categoria: Categoria;
}

const { categoria } = Astro.props;

const todosLosArticulos = await getCollection('articulos');
const articulosDeCategoria = todosLosArticulos
  .filter((art) => art.data.categoria === categoria.slug)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const sinArticulos = articulosDeCategoria.length === 0;
---

<Layout
  title={`${categoria.nombre} | Guías y Artículos de IA`}
  description={categoria.descripcion}
  noindex={sinArticulos}
>
  <div class="space-y-10">
    <!-- Migas de pan -->
    <nav aria-label="Migas de pan" class="flex items-center gap-2 text-xs font-medium text-tinta-suave">
      <a href="/" class="hover:text-indigo transition-colors">
        Inicio
      </a>
      <span>/</span>
      <a href="/articulos" class="hover:text-indigo transition-colors">
        Artículos
      </a>
      <span>/</span>
      <span class="text-tinta font-semibold">
        {categoria.nombre}
      </span>
    </nav>

    <!-- Cabecera de Categoría (sin emojis, con regla lateral) -->
    <header class="space-y-3 max-w-3xl border-b border-linea pb-8">
      <div class={`border-l-[3px] ${categoria.clases.bordeLateral} pl-4 space-y-2`}>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-tinta">
          {categoria.nombre}
        </h1>
        <p class="text-base sm:text-lg text-tinta-suave leading-relaxed">
          {categoria.descripcion}
        </p>
      </div>
    </header>

    <!-- Artículos de la categoría -->
    <section aria-labelledby="titulo-articulos-categoria" class="space-y-6">
      <h2 id="titulo-articulos-categoria" class="sr-only">
        Publicaciones en {categoria.nombre}
      </h2>

      {sinArticulos ? (
        <div class="p-8 border border-linea bg-superficie text-center space-y-3">
          <h3 class="text-base font-bold text-tinta">
            Próximamente publicaremos guías en esta categoría
          </h3>
          <p class="text-xs sm:text-sm text-tinta-suave max-w-md mx-auto">
            Estamos preparando artículos y talleres interactivos para {categoria.nombre.toLowerCase()}. Vuelve pronto o explora otras secciones.
          </p>
          <div class="pt-2">
            <a
              href="/articulos"
              class="inline-flex items-center px-4 py-2 rounded-[6px] text-xs font-bold bg-indigo text-white hover:opacity-90 transition-opacity"
            >
              Explorar todos los artículos
            </a>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {articulosDeCategoria.map((art) => (
            <TarjetaArticulo articulo={art} />
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>
