---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroDemo from '../components/HeroDemo.astro';
import Anuncio from '../components/Anuncio.astro';
import { CATEGORIAS, getCategoria } from '../data/categorias';

const articulos = await getCollection('articulos');
const articulosOrdenados = articulos.sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

const conteoCategorias = new Map<string, number>();
for (const art of articulos) {
  conteoCategorias.set(art.data.categoria, (conteoCategorias.get(art.data.categoria) || 0) + 1);
}

const primerArticulo = articulosOrdenados[0];
const otrosArticulos = articulosOrdenados.slice(1, 5);

const formateadorFecha = new Intl.DateTimeFormat('es', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

function calcularMinutos(body?: string): number {
  const palabras = body ? body.split(/\s+/).filter(Boolean).length : 0;
  return Math.max(1, Math.ceil(palabras / 200));
}
---

<Layout
  title="AprendeIA | Aprende a usar CUALQUIER IA. Paso a paso."
  description="Guías prácticas de ChatGPT, Gemini, Midjourney, Suno y más de 30 herramientas de IA. Para todo el mundo, en español."
>
  <div class="space-y-20 md:space-y-28">
    <!-- 1. HERO -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start pt-4 sm:pt-8 relative animar-entrada-init">
      <!-- Partículas sutiles en modo oscuro (CSS puro) -->
      <div class="particulas-hero" aria-hidden="true">
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
        <span class="particula"></span>
      </div>

      <!-- Columna izquierda: titular y botones -->
      <div class="lg:col-span-7 space-y-6 text-left relative z-10">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.08]">
          <span class="texto-gradiente">Aprende a usar CUALQUIER IA. Paso a paso.</span>
        </h1>
        <p class="text-base sm:text-lg text-tinta-suave leading-relaxed max-w-xl">
          Guías prácticas de ChatGPT, Gemini, Midjourney, Suno y más de 30 herramientas de IA. Para todo el mundo, en español.
        </p>
        <div class="pt-2 flex items-center gap-3 flex-wrap">
          <a
            href="/articulos"
            class="px-5 py-2.5 rounded-[6px] font-bold text-sm bg-indigo text-sobre-acento hover:opacity-90 transition-opacity"
          >
            Explorar todas las IAs
          </a>
          <a
            href="/articulos/cual-ia-para-que"
            class="px-5 py-2.5 rounded-[6px] font-semibold text-sm bg-superficie border border-linea text-tinta hover:bg-papel transition-colors"
          >
            ¿Cuál IA necesito?
          </a>
        </div>

        <!-- Estadísticas rápidas con contadores animados -->
        <div class="pt-3 flex items-center gap-4 text-xs text-tinta-suave border-t border-linea/60 max-w-lg">
          <div class="flex items-center gap-1.5">
            <span
              class="font-mono font-bold text-indigo"
              data-contador-valor="16"
              data-contador-sufijo="+"
            >16+</span>
            <span>Guías publicadas</span>
          </div>
          <span class="text-linea" aria-hidden="true">|</span>
          <div class="flex items-center gap-1.5">
            <span
              class="font-mono font-bold text-indigo"
              data-contador-valor="30"
              data-contador-sufijo="+"
            >30+</span>
            <span>Herramientas cubiertas</span>
          </div>
          <span class="text-linea" aria-hidden="true">|</span>
          <div class="flex items-center gap-1.5">
            <span
              class="font-mono font-bold text-indigo"
              data-contador-valor="100"
              data-contador-sufijo="%"
            >100%</span>
            <span>Gratuito</span>
          </div>
        </div>
      </div>

      <!-- Columna derecha: demo del hero -->
      <div class="lg:col-span-5 w-full relative z-10">
        <HeroDemo />
      </div>
    </section>

    <!-- 2. "Empieza por aquí" (10 categorías completas) -->
    <section aria-labelledby="seccion-empieza-por-aqui" class="space-y-8 animar-entrada-init">
      <div class="border-b border-linea pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <h2 id="seccion-empieza-por-aqui" class="text-2xl font-bold tracking-tight text-tinta">
            Empieza por aquí
          </h2>
          <p class="text-sm text-tinta-suave mt-1">
            Explora las 10 disciplinas de Inteligencia Artificial organizadas por propósito.
          </p>
        </div>
        <span class="text-xs text-tinta-suave font-medium">
          10 áreas temáticas
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {CATEGORIAS.map((cat) => {
          const cantidad = conteoCategorias.get(cat.slug) || 0;
          const tieneArticulos = cantidad > 0;
          const textoCantidad = cantidad === 1 ? '1 artículo disponible' : `${cantidad} artículos`;

          if (tieneArticulos) {
            return (
              <a
                href={`/categoria/${cat.slug}`}
                class={`p-6 border border-linea bg-superficie border-l-[4px] ${cat.clases.bordeLateral} hover:bg-papel hover:border-linea-fuerte transition-all block group relative`}
              >
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-2.5">
                    <span class="text-2xl shrink-0" aria-hidden="true">
                      {cat.emoji || '✨'}
                    </span>
                    <h3 class={`text-lg font-bold ${cat.clases.texto} group-hover:underline`}>
                      {cat.nombre}
                    </h3>
                  </div>
                  <span class="text-[11px] font-semibold px-2 py-0.5 rounded-[4px] bg-papel border border-linea text-tinta-suave shrink-0">
                    {textoCantidad}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
                  {cat.descripcion}
                </p>
              </a>
            );
          }

          return (
            <div
              class="p-6 border border-linea bg-superficie/60 border-l-[4px] border-l-linea opacity-75 select-none relative"
            >
              <div class="flex items-start justify-between gap-3 mb-3">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl grayscale shrink-0" aria-hidden="true">
                    {cat.emoji || '✨'}
                  </span>
                  <h3 class="text-lg font-bold text-tinta-suave">
                    {cat.nombre}
                  </h3>
                </div>
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-[4px] bg-papel border border-linea text-tinta-suave shrink-0">
                  Próximamente
                </span>
              </div>
              <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
                {cat.descripcion}
              </p>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 3. SECCIÓN "Etapas de aprendizaje" -->
    <section aria-labelledby="seccion-etapas-aprendizaje" class="space-y-8 animar-entrada-init">
      <div class="border-b border-linea pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <h2 id="seccion-etapas-aprendizaje" class="text-2xl font-bold tracking-tight text-tinta">
            Etapas de aprendizaje
          </h2>
          <p class="text-sm text-tinta-suave mt-1">
            Una ruta de progreso paso a paso: desde entender cómo piensa un modelo hasta dominar el uso ético y avanzado.
          </p>
        </div>
        <span class="text-xs font-mono font-bold text-indigo">
          De novato a usuario con criterio
        </span>
      </div>

      <!-- Contenedor scroll horizontal con tarjetas de ancho fijo 200px en desktop -->
      <div class="overflow-x-auto pb-4 pt-1 -mx-4 px-4 sm:mx-0 sm:px-0">
        <div class="flex gap-4 min-w-max">
          {CATEGORIAS.map((cat, index) => {
            const numeroEtapa = (index + 1).toString().padStart(2, '0');
            const cantidad = conteoCategorias.get(cat.slug) || 0;
            const tieneArticulos = cantidad > 0;

            const CardContent = (
              <div
                class={`w-[200px] shrink-0 p-5 border border-linea bg-superficie rounded-[6px] flex flex-col justify-between space-y-3 relative hover:-translate-y-1 hover:shadow-md transition-all ${
                  tieneArticulos ? 'hover:border-indigo/60 etapa-activa-pulse' : 'opacity-75'
                }`}
              >
                <!-- Número de etapa y emoji grande -->
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-xs font-bold text-indigo">
                      {numeroEtapa}
                    </span>
                    <span class="text-[11px] text-tinta-suave font-medium">
                      {tieneArticulos ? `${cantidad} ${cantidad === 1 ? 'guía' : 'guías'}` : 'Próx.'}
                    </span>
                  </div>
                  <div class="text-3xl" aria-hidden="true">
                    {cat.emoji || '✨'}
                  </div>
                </div>

                <!-- Título y descripción -->
                <div class="space-y-1">
                  <h3 class="text-sm font-bold text-tinta tracking-tight line-clamp-1">
                    {cat.nombre}
                  </h3>
                  <p class="text-xs text-tinta-suave leading-relaxed line-clamp-3">
                    {cat.descripcion}
                  </p>
                </div>

                <!-- Pie de tarjeta -->
                <div class="pt-2 border-t border-linea/60 text-xs">
                  {tieneArticulos ? (
                    <span class="font-semibold text-indigo flex items-center justify-between">
                      <span>Ver guías</span>
                      <span aria-hidden="true">&rarr;</span>
                    </span>
                  ) : (
                    <span class="text-tinta-suave text-[11px] italic">
                      Próximamente
                    </span>
                  )}
                </div>
              </div>
            );

            if (tieneArticulos) {
              return (
                <a href={`/categoria/${cat.slug}`} class="block focus:outline-none focus:ring-2 focus:ring-indigo rounded-[6px]">
                  {CardContent}
                </a>
              );
            }

            return (
              <div class="block">
                {CardContent}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 4. "Practica sin salir de la página" -->
    <section aria-labelledby="seccion-practica-en-pagina" class="space-y-8">
      <div class="border-b border-linea pb-4">
        <h2 id="seccion-practica-en-pagina" class="text-2xl font-bold tracking-tight text-tinta">
          Practica sin salir de la página
        </h2>
        <p class="text-sm text-tinta-suave mt-1">
          Módulos interactivos integrados en los artículos para probar lo aprendido al instante.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        <!-- Panel 1: Explorador por profesión -->
        <article class="p-6 sm:p-8 border border-linea bg-superficie flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <span class="text-xs font-bold text-sky-700 dark:text-sky-400">
              Orientación profesional
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-tinta tracking-tight">
              Explorador por profesión
            </h3>
            <p class="text-sm text-tinta-suave leading-relaxed">
              Eliges un ámbito de trabajo y un objetivo laboral específico. Recibes una herramienta sugerida, un beneficio concreto y un prompt de ejemplo listo para copiar y adaptar.
            </p>
          </div>
          <div>
            <a
              href="/articulos/beneficios-ia"
              class="inline-block px-4 py-2 rounded-[6px] text-xs font-bold bg-indigo text-sobre-acento hover:opacity-90 transition-opacity"
            >
              Abrir el explorador
            </a>
          </div>
        </article>

        <!-- Panel 2: Constructor de prompts -->
        <article class="p-6 sm:p-8 border border-linea bg-superficie flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400">
              Ingeniería de instrucciones
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-tinta tracking-tight">
              Constructor de prompts
            </h3>
            <p class="text-sm text-tinta-suave leading-relaxed">
              Aprende a formular órdenes efectivas con la regla de 4 pasos: rol, contexto, tarea y tono. La herramienta ensambla la instrucción en tiempo real con resaltado visual.
            </p>
          </div>
          <div>
            <a
              href="/articulos/hablar-con-la-ia"
              class="inline-block px-4 py-2 rounded-[6px] text-xs font-bold bg-indigo text-sobre-acento hover:opacity-90 transition-opacity"
            >
              Armar un prompt
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- 5. "Lo último que publicamos" -->
    <section aria-labelledby="seccion-lo-ultimo" class="space-y-8">
      <div class="flex items-center justify-between border-b border-linea pb-4">
        <div>
          <h2 id="seccion-lo-ultimo" class="text-2xl font-bold tracking-tight text-tinta">
            Lo último que publicamos
          </h2>
          <p class="text-sm text-tinta-suave mt-1">
            Artículos explicativos y guías paso a paso de acceso libre.
          </p>
        </div>
        <a href="/articulos" class="text-xs font-semibold text-indigo hover:underline hidden sm:block">
          Ver todos los artículos
        </a>
      </div>

      <div class="space-y-6">
        <!-- Artículo más reciente (con badge NUEVO) -->
        {primerArticulo && (() => {
          const catInfo = getCategoria(primerArticulo.data.categoria);
          const minutos = calcularMinutos(primerArticulo.body);
          const fechaFormateada = formateadorFecha.format(primerArticulo.data.fecha);
          return (
            <article class={`p-6 sm:p-8 border border-linea bg-superficie border-l-[3px] ${catInfo?.clases.bordeLateral || 'border-l-indigo'}`}>
              <div class="flex items-center gap-3 text-xs text-tinta-suave mb-3 flex-wrap">
                <!-- Badge NUEVO en color índigo -->
                <span class="px-2 py-0.5 rounded-[4px] font-mono text-[11px] font-bold bg-indigo/10 text-indigo dark:bg-indigo/20 border border-indigo/20">
                  NUEVO
                </span>
                {catInfo && (
                  <a href={`/categoria/${catInfo.slug}`} class={`font-bold ${catInfo.clases.texto} hover:underline`}>
                    {catInfo.nombre}
                  </a>
                )}
                <time datetime={primerArticulo.data.fecha.toISOString()}>{fechaFormateada}</time>
                <span>{minutos} min de lectura</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-tinta mb-3">
                <a href={`/articulos/${primerArticulo.id}`} class="hover:text-indigo transition-colors">
                  {primerArticulo.data.titulo}
                </a>
              </h3>
              <p class="text-sm sm:text-base text-tinta-suave leading-relaxed max-w-3xl mb-6">
                {primerArticulo.data.descripcion}
              </p>
              <div>
                <a
                  href={`/articulos/${primerArticulo.id}`}
                  class="text-xs font-semibold text-indigo hover:underline"
                >
                  Leer guía completa
                </a>
              </div>
            </article>
          );
        })()}

        <!-- Artículos restantes en filas compactas (hasta 5 en total) -->
        {otrosArticulos.length > 0 && (
          <div class="border-y border-linea divide-y divide-linea bg-superficie">
            {otrosArticulos.map((art) => {
              const catInfo = getCategoria(art.data.categoria);
              const minutos = calcularMinutos(art.body);
              const fechaFormateada = formateadorFecha.format(art.data.fecha);
              return (
                <article class={`p-4 sm:p-5 border-l-[3px] ${catInfo?.clases.bordeLateral || 'border-l-indigo'} flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-papel transition-colors`}>
                  <div class="space-y-1 min-w-0">
                    <div class="flex items-center gap-3 text-xs text-tinta-suave">
                      {catInfo && (
                        <a href={`/categoria/${catInfo.slug}`} class={`font-bold ${catInfo.clases.texto} hover:underline`}>
                          {catInfo.nombre}
                        </a>
                      )}
                      <time datetime={art.data.fecha.toISOString()}>{fechaFormateada}</time>
                      <span>{minutos} min de lectura</span>
                    </div>
                    <h4 class="text-base font-bold text-tinta truncate">
                      <a href={`/articulos/${art.id}`} class="hover:text-indigo transition-colors">
                        {art.data.titulo}
                      </a>
                    </h4>
                  </div>
                  <div class="shrink-0 self-start sm:self-auto">
                    <a
                      href={`/articulos/${art.id}`}
                      class="text-xs font-semibold text-indigo hover:underline"
                    >
                      Leer artículo
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        )}

        <div class="pt-2 sm:hidden">
          <a href="/articulos" class="text-xs font-semibold text-indigo hover:underline block">
            Ver todos los artículos
          </a>
        </div>
      </div>

      <!-- Anuncio condicional: solo si hay 3 o más artículos publicados. Es el único de la portada -->
      {articulos.length >= 3 && <Anuncio posicion="medio" />}
    </section>

    <!-- 6. "Cómo se aprende aquí" (secuencia numerada 1, 2, 3) -->
    <section aria-labelledby="seccion-metodo-aprendizaje" class="space-y-8">
      <div class="border-b border-linea pb-4">
        <h2 id="seccion-metodo-aprendizaje" class="text-2xl font-bold tracking-tight text-tinta">
          Cómo se aprende aquí
        </h2>
        <p class="text-sm text-tinta-suave mt-1">
          Un método directo enfocado en la comprensión conceptual y la aplicación inmediata.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 border border-linea bg-superficie space-y-3">
          <span class="font-mono text-xs font-bold text-indigo">
            01
          </span>
          <h3 class="text-lg font-bold text-tinta">
            Lee una guía corta
          </h3>
          <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
            Cada artículo va al grano y se lee en pocos minutos.
          </p>
        </div>

        <div class="p-6 border border-linea bg-superficie space-y-3">
          <span class="font-mono text-xs font-bold text-indigo">
            02
          </span>
          <h3 class="text-lg font-bold text-tinta">
            Practica con la herramienta
          </h3>
          <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
            Prueba lo que acabas de leer en la misma página.
          </p>
        </div>

        <div class="p-6 border border-linea bg-superficie space-y-3">
          <span class="font-mono text-xs font-bold text-indigo">
            03
          </span>
          <h3 class="text-lg font-bold text-tinta">
            Aplícalo a tu caso
          </h3>
          <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
            Copia el prompt, cámbialo por tu situación y úsalo.
          </p>
        </div>
      </div>
    </section>

    <!-- 7. "¿Por qué aprender a usar IA?" (nueva sección antes del buscador) -->
    <section aria-labelledby="seccion-por-que-aprender-ia" class="space-y-8">
      <div class="border-b border-linea pb-4">
        <h2 id="seccion-por-que-aprender-ia" class="text-2xl font-bold tracking-tight text-tinta">
          ¿Por qué aprender a usar IA?
        </h2>
        <p class="text-sm text-tinta-suave mt-1">
          Tres razones fundamentales para sumar herramientas inteligentes a tu día a día.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 border border-linea bg-superficie rounded-[6px] space-y-3 hover:border-linea-fuerte transition-colors">
          <span class="text-3xl block" aria-hidden="true">🕐</span>
          <h3 class="text-lg font-bold text-tinta">
            Ahorra tiempo
          </h3>
          <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
            Lo que hoy te toma horas, con IA lo haces en minutos.
          </p>
        </div>

        <div class="p-6 border border-linea bg-superficie rounded-[6px] space-y-3 hover:border-linea-fuerte transition-colors">
          <span class="text-3xl block" aria-hidden="true">🌍</span>
          <h3 class="text-lg font-bold text-tinta">
            Úsala para todo
          </h3>
          <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
            Escribir, diseñar, programar, estudiar, crear música y mucho más.
          </p>
        </div>

        <div class="p-6 border border-linea bg-superficie rounded-[6px] space-y-3 hover:border-linea-fuerte transition-colors">
          <span class="text-3xl block" aria-hidden="true">🆓</span>
          <h3 class="text-lg font-bold text-tinta">
            Empieza gratis
          </h3>
          <p class="text-xs sm:text-sm text-tinta-suave leading-relaxed">
            La mayoría de herramientas tienen plan gratuito para comenzar hoy.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. Cierre: buscador -->
    <section aria-labelledby="seccion-cierre-buscador" class="p-6 sm:p-10 border border-linea bg-superficie space-y-4">
      <div class="space-y-1">
        <h2 id="seccion-cierre-buscador" class="text-xl sm:text-2xl font-bold tracking-tight text-tinta">
          ¿Buscas un tema concreto?
        </h2>
        <p class="text-xs sm:text-sm text-tinta-suave">
          Encuentra explicaciones, tutoriales y comparativas de herramientas en nuestra biblioteca.
        </p>
      </div>

      <form action="/buscar" method="GET" class="flex flex-col sm:flex-row gap-3 pt-2 max-w-xl">
        <label for="campo-busqueda-portada" class="sr-only">
          Término de búsqueda
        </label>
        <input
          type="search"
          id="campo-busqueda-portada"
          name="q"
          placeholder="Escribe lo que buscas (ej. finanzas, redacción, ChatGPT)..."
          class="flex-1 px-4 py-2.5 text-sm bg-papel border border-linea text-tinta placeholder:text-tinta-suave rounded-[6px] focus:outline-none focus:ring-2 focus:ring-indigo"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-[6px] text-xs font-bold bg-indigo text-sobre-acento hover:opacity-90 transition-opacity cursor-pointer shrink-0"
        >
          Buscar
        </button>
      </form>
    </section>
  </div>
</Layout>
