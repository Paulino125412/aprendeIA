---
import Layout from '../layouts/Layout.astro';
import { CATEGORIAS } from '../data/categorias';
---

<Layout
  title="AprendeIA | Educación Práctica sobre Inteligencia Artificial"
  description="Domina el uso productivo y ético de la Inteligencia Artificial con guías prácticas, talleres e islas interactivas para aprender haciendo."
>
  <div class="space-y-16">
    <!-- Sección de Introducción / Hero -->
    <section class="py-8 md:py-14 max-w-3xl space-y-4">
      <p class="text-xs font-semibold text-tinta-suave">
        Educación abierta en inteligencia artificial
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-tinta leading-tight">
        Aprende a colaborar con la Inteligencia Artificial haciendo
      </h1>
      <p class="text-base sm:text-lg text-tinta-suave leading-relaxed max-w-2xl">
        Plataforma formativa libre de tecnicismos vacíos. Descubre aplicaciones concretas para tu disciplina y domina la formulación de instrucciones precisas con talleres interactivos.
      </p>
      <div class="pt-4 flex items-center gap-3 flex-wrap">
        <a
          href="/articulos"
          class="px-5 py-2.5 rounded-[6px] font-bold text-sm bg-indigo text-white hover:opacity-90 transition-opacity"
        >
          Explorar todos los artículos
        </a>
        <a
          href="/articulos/hablar-con-la-ia"
          class="px-5 py-2.5 rounded-[6px] font-semibold text-sm bg-superficie border border-linea text-tinta hover:bg-papel transition-colors"
        >
          Taller de formulación
        </a>
      </div>
    </section>

    <!-- Sección de Categorías -->
    <section aria-labelledby="seccion-categorias-home" class="space-y-6">
      <div class="flex items-center justify-between border-b border-linea pb-4">
        <div>
          <h2 id="seccion-categorias-home" class="text-2xl font-bold text-tinta tracking-tight">
            Categorías temáticas
          </h2>
          <p class="text-sm text-tinta-suave mt-0.5">
            Encuentra guías y talleres enfocados exactamente en lo que necesitas aprender.
          </p>
        </div>
        <a href="/articulos" class="text-xs font-semibold text-indigo hover:underline hidden sm:block">
          Ver todas las publicaciones
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {CATEGORIAS.map((cat) => (
          <a
            href={`/categoria/${cat.slug}`}
            class={`border border-linea bg-superficie p-4 border-l-[3px] ${cat.clases.bordeLateral} hover:bg-papel transition-colors group block`}
          >
            <h3 class={`text-sm font-bold ${cat.clases.texto} transition-colors`}>
              {cat.nombre}
            </h3>
            <p class="text-xs text-tinta-suave mt-1 line-clamp-2 leading-relaxed">
              {cat.descripcion}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Artículos destacados con islas interactivas (radio 12px en demo cards) -->
    <section aria-labelledby="seccion-articulos-destacados" class="space-y-6">
      <div class="border-b border-linea pb-4">
        <h2 id="seccion-articulos-destacados" class="text-2xl font-bold text-tinta tracking-tight">
          Guías y talleres destacados
        </h2>
        <p class="text-sm text-tinta-suave mt-0.5">
          Aprende con simuladores y generadores integrados en el propio artículo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Tarjeta Demo 1: radio 12px -->
        <article class="flex flex-col justify-between p-6 sm:p-8 rounded-[12px] bg-superficie border border-linea">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs text-tinta-suave">
              <span class="font-bold text-sky-600 dark:text-sky-400">
                IA en tu profesión
              </span>
              <span>Guía práctica</span>
            </div>
            <h3 class="text-2xl font-bold text-tinta tracking-tight">
              Beneficios de la IA en cualquier profesión
            </h3>
            <p class="text-sm text-tinta-suave leading-relaxed">
              Descubre qué herramienta utilizar según tu perfil profesional (Educación, Programación, Negocios, Vida Cotidiana o Diseño) y obtén prompts optimizados de inmediato.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-linea flex items-center justify-between">
            <span class="text-xs font-medium text-tinta-suave">Incluye explorador interactivo</span>
            <a
              href="/articulos/beneficios-ia"
              class="text-sm font-bold text-indigo hover:underline"
            >
              Explorar artículo
            </a>
          </div>
        </article>

        <!-- Tarjeta Demo 2: radio 12px -->
        <article class="flex flex-col justify-between p-6 sm:p-8 rounded-[12px] bg-superficie border border-linea">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs text-tinta-suave">
              <span class="font-bold text-emerald-600 dark:text-emerald-400">
                Prompting
              </span>
              <span>Taller interactivo</span>
            </div>
            <h3 class="text-2xl font-bold text-tinta tracking-tight">
              Hablar con la IA correctamente: La regla de 4 pasos
            </h3>
            <p class="text-sm text-tinta-suave leading-relaxed">
              Aprende a formular instrucciones infalibles separando Rol, Contexto, Tarea y Tono con un taller interactivo que ensambla tu prompt en vivo con resaltado visual.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-linea flex items-center justify-between">
            <span class="text-xs font-medium text-tinta-suave">Incluye constructor en vivo</span>
            <a
              href="/articulos/hablar-con-la-ia"
              class="text-sm font-bold text-emerald-600 dark:text-emerald-400 hover:underline"
            >
              Abrir taller
            </a>
          </div>
        </article>
      </div>
    </section>
  </div>
</Layout>
