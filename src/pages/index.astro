---
import Layout from '../layouts/Layout.astro';
import { CATEGORIAS } from '../data/categorias';
---

<Layout
  title="Aprende IA | Plataforma Educativa Interactiva"
  description="Domina el uso productivo y ético de la Inteligencia Artificial con guías prácticas, talleres e islas interactivas para aprender haciendo."
>
  <div class="space-y-16">
    <!-- Hero Section -->
    <section class="text-center py-10 md:py-16 max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-indigo-700 bg-indigo-50 dark:text-indigo-300 dark:bg-indigo-950/60 rounded-full border border-indigo-200 dark:border-indigo-800">
        Educación Abierta en IA
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
        Aprende a colaborar con la Inteligencia Artificial <span class="text-indigo-600 dark:text-indigo-400">haciendo</span>
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Plataforma formativa libre de tecnicismos vacíos. Descubre aplicaciones concretas para tu disciplina y domina la formulación de prompts precisos con nuestras herramientas interactivas.
      </p>
      <div class="pt-4 flex items-center justify-center gap-4 flex-wrap">
        <a
          href="/articulos"
          class="px-5 py-2.5 rounded-xl font-bold text-sm bg-indigo-600 text-white hover:bg-indigo-700 transition-colors shadow-sm"
        >
          Explorar todos los artículos
        </a>
        <a
          href="/articulos/hablar-con-la-ia"
          class="px-5 py-2.5 rounded-xl font-semibold text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 hover:border-slate-300 transition-colors"
        >
          Taller de Prompting
        </a>
      </div>
    </section>

    <!-- Sección de Categorías -->
    <section aria-labelledby="seccion-categorias-home" class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 id="seccion-categorias-home" class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
            Categorías temáticas
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Encuentra guías y talleres enfocados exactamente en lo que necesitas aprender.
          </p>
        </div>
        <a href="/articulos" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline hidden sm:block">
          Ver todas las publicaciones →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {CATEGORIAS.map((cat) => (
          <a
            href={`/categoria/${cat.slug}`}
            class="flex items-start gap-3.5 p-4 rounded-xl border border-slate-200 bg-white hover:border-indigo-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500 transition-all group"
          >
            <span class="text-2xl p-2 rounded-lg bg-slate-50 dark:bg-slate-800/80 shrink-0">
              {cat.emoji}
            </span>
            <div class="flex flex-col min-w-0">
              <h3 class="text-sm font-bold text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400 transition-colors">
                {cat.nombre}
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-2 leading-relaxed">
                {cat.descripcion}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Artículos destacados con islas interactivas -->
    <section aria-labelledby="seccion-articulos-destacados" class="space-y-6">
      <div>
        <h2 id="seccion-articulos-destacados" class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
          Guías y talleres destacados
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          Aprende con simuladores y generadores integrados en el propio artículo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Tarjeta Artículo 1 -->
        <article class="flex flex-col justify-between p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full border bg-sky-50 text-sky-700 border-sky-200 dark:bg-sky-950/60 dark:text-sky-300 dark:border-sky-800">
                💼 IA en tu profesión
              </span>
              <span class="text-xs text-slate-400">Guía práctica</span>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white">
              Beneficios de la IA en cualquier profesión
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Descubre qué herramienta utilizar según tu perfil profesional (Educación, Programación, Negocios, Vida Cotidiana o Diseño) y obtén prompts optimizados de inmediato.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Incluye explorador interactivo</span>
            <a
              href="/articulos/beneficios-ia"
              class="inline-flex items-center gap-1.5 text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300"
            >
              Explorar artículo
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>

        <!-- Tarjeta Artículo 2 -->
        <article class="flex flex-col justify-between p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full border bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800">
                ✍️ Prompting
              </span>
              <span class="text-xs text-slate-400">Taller interactivo</span>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white">
              Hablar con la IA correctamente: La regla de 4 pasos
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Aprende a formular instrucciones infalibles separando Rol, Contexto, Tarea y Tono con un taller interactivo que ensambla tu prompt en vivo con resaltado visual.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Incluye constructor en vivo</span>
            <a
              href="/articulos/hablar-con-la-ia"
              class="inline-flex items-center gap-1.5 text-sm font-bold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300"
            >
              Abrir taller
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      </div>
    </section>
  </div>
</Layout>
