---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { CATEGORIAS } from '../../data/categorias';

const articulos = await getCollection('articulos');
const ordenados = articulos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<Layout
  title="Artículos y Guías | AprendeIA"
  description="Explora nuestra biblioteca completa de artículos, talleres interactivos y guías prácticas sobre Inteligencia Artificial."
>
  <div class="space-y-10">
    <header class="space-y-3 max-w-3xl border-b border-linea pb-8">
      <p class="text-xs font-semibold text-tinta-suave">
        Biblioteca formativa
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-tinta">
        Artículos, talleres y guías de IA
      </h1>
      <p class="text-base sm:text-lg text-tinta-suave leading-relaxed">
        Contenido estructurado para aprender a utilizar modelos de inteligencia artificial en el trabajo, los estudios y la vida cotidiana.
      </p>
    </header>

    <!-- Filtro por categoría temática (sin emojis, radio 6px) -->
    <section aria-labelledby="titulo-categorias" class="space-y-3">
      <h2 id="titulo-categorias" class="text-xs font-bold text-tinta-suave">
        Filtrar por categoría temática
      </h2>
      <div class="flex flex-wrap gap-2">
        <a
          href="/articulos"
          class="inline-flex items-center px-3 py-1.5 rounded-[6px] text-xs font-bold bg-indigo text-white"
        >
          Todos ({ordenados.length})
        </a>
        {CATEGORIAS.map((cat) => (
          <a
            href={`/categoria/${cat.slug}`}
            class={`inline-flex items-center px-3 py-1.5 rounded-[6px] text-xs font-semibold border border-linea bg-superficie hover:bg-papel transition-colors ${cat.clases.texto}`}
          >
            {cat.nombre}
          </a>
        ))}
      </div>
    </section>

    <!-- Listado de artículos -->
    <section aria-labelledby="titulo-listado" class="space-y-6">
      <h2 id="titulo-listado" class="sr-only">
        Listado completo de publicaciones
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {ordenados.map((articulo) => (
          <TarjetaArticulo articulo={articulo} />
        ))}
      </div>
    </section>
  </div>
</Layout>
